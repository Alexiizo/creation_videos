# Copie ce fichier en .env (l'installateur le fait) et remplis-le. .env n'est JAMAIS commité (.gitignore).
ELEVENLABS_API_KEY=ta_cle_ici
# Optionnel : l'identifiant exact de la voix (sinon : la voix de « Mes voix » dont le nom contient « Guillaume »)
ELEVENLABS_VOICE_ID=
# Optionnel : eleven_multilingual_v2 (défaut, stable) ou eleven_v3 (plus expressif, accepte [doucement], [ému]…)
ELEVENLABS_MODELE=eleven_multilingual_v2
